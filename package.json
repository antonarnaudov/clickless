{
  "name": "clickless",
  "productName": "Clickless",
  "version": "0.1.0",
  "description": "The AI-native open-source browser for everybody. Say it, it's done: any AI (Claude Code, local LLMs, any API) drives your real browser in a few calls.",
  "license": "MIT",
  "author": "Anton Arnaudov",
  "main": "dist/main/index.js",
  "bin": {
    "clickless": "dist/cli/clickless.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:main": "node scripts/build.mjs --only=node",
    "build:ui": "vite build",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "ui:dev": "vite --port 5199",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/build.mjs --only=node && node --test test/*.test.mjs",
    "test:e2e": "node scripts/build.mjs && node test/e2e/run.mjs",
    "dist": "node scripts/build.mjs && electron-builder --mac --dir",
    "dist:dmg": "node scripts/build.mjs && electron-builder --mac"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.70.0",
    "markdown-it": "^15.0.3",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonarnaudov/clickless.git"
  },
  "homepage": "https://github.com/antonarnaudov/clickless",
  "keywords": [
    "browser",
    "ai",
    "agent",
    "mcp",
    "electron",
    "automation",
    "claude",
    "llm",
    "arc"
  ],
  "build": {
    "appId": "app.clickless",
    "productName": "Clickless",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "darkModeSupport": true,
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "icon": "assets/icon.png"
  }
}
