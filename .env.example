# Clickless reads no secrets from the environment: API keys are entered in Settings → AI and stored
# encrypted with the OS keychain. These variables are for development and scripting only.

# --- development ---
# CLICKLESS_USER_DATA=/tmp/clickless-profile    # run with a separate profile (tabs, settings, logins)
# CLICKLESS_HOME=/tmp/clickless-home            # separate discovery folder, so a test copy can run next to your real one
# CLICKLESS_NO_FOCUS=1                          # test copies: agent requests don't bring the window to the front
# CLICKLESS_PORT=0                              # control API port override (0 = any free port; agent profiles use it)
# CLICKLESS_DEV_URL=http://localhost:5199   # load the UI from the Vite dev server (npm run ui:dev)
# CLICKLESS_DEBUG=1                         # enable /v1/debug/ui and /v1/debug/cmd on the local API

# --- CLI / scripts (normally read from ~/.clickless/control.json) ---
# CLICKLESS_URL=http://127.0.0.1:7734
# CLICKLESS_TOKEN=
# CLICKLESS_CLIENT=my-agent                 # name shown in the browser while your agent drives
